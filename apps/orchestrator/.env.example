# ============================================================================
# Outlook AI Orchestrator — backend configuration / configuration du backend
# Copy to .env (never commit secrets) / Copier vers .env (jamais de secrets en git)
#
# Every variable has a safe default: `LLM_PROVIDER=mock DATABASE_URL=memory`
# runs the whole product without Postgres and without a GPU.
#
# Kubernetes / NKP: any variable also accepts a `_FILE` twin pointing at a
# mounted secret, e.g. `DATABASE_URL_FILE=/run/secrets/database-url`,
# `LLM_API_KEY_FILE=…`, `AAD_CLIENT_SECRET_FILE=…`, `ADMIN_API_TOKEN_FILE=…`.
# The file is read once at boot, trailing newlines stripped; an explicitly set,
# non-empty variable always wins over its file.
# ============================================================================

# --- Process role -----------------------------------------------------------
# api = HTTP only · worker = scheduled jobs only · all = both (single process)
ROLE=all
# Scheduler master switch (sync, daily brief, retention). Ignored when ROLE=api.
WORKERS_ENABLED=true

# --- AI model (OpenAI-compatible endpoint hosted internally) ---------------
# Provider: "openai-compatible" (vLLM, Ollama, LM Studio, TGI, Azure OpenAI…) or "mock" (demo/tests)
LLM_PROVIDER=mock
# Base URL of the OpenAI-compatible API (must end with /v1 for most servers)
LLM_BASE_URL=http://gpu-node.northbridge.local:8000/v1
# Optional API key, sent as "Authorization: Bearer …" only when set / clé optionnelle
LLM_API_KEY=
LLM_MODEL=qwen3-30b-a3b
# Optional smaller model on the SAME endpoint, used for classification, compliance
# content checks, extraction and triage-assist. Empty = single-tier (see docs/AI_LOAD.md §7).
LLM_FAST_MODEL=
LLM_TIMEOUT_MS=60000
LLM_MAX_TOKENS=2048
# How to force JSON output: auto | response_format | prompt
LLM_JSON_MODE=auto
# Embeddings (same endpoint, POST /embeddings). false → lexical search only / recherche lexicale seule
EMBEDDINGS_ENABLED=false
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
# Texts per /embeddings HTTP call / textes par appel
EMBEDDING_BATCH_SIZE=64

# --- AI-load minimisation (docs/AI_LOAD.md) ---------------------------------
# Heuristic triage before ANY model call: newsletters, notifications, out-of-office,
# calendar items and trivial acknowledgements are answered from rules only.
# false → every email goes to the model (roughly doubles the analysis calls).
TRIAGE_ENABLED=true
# Content-hash cache of analyses / thread syntheses / drafts (per user).
ANALYSIS_CACHE_ENABLED=true
ANALYSIS_CACHE_TTL_HOURS=168
# Embedding cache keyed by (model, chunk sha256): re-indexing never re-embeds.
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_TTL_DAYS=365
# Hard cap on the body text sent to the model (head + tail kept, "[…]" marks the cut).
LLM_INPUT_MAX_CHARS=12000
# Thread messages kept verbatim; older ones become a one-line-per-message digest.
THREAD_MAX_MESSAGES=12
# Part of EVERY cache key: bump it whenever a prompt changes, to invalidate the cache.
PROMPT_VERSION=2026-09-v2
# Concurrent model calls allowed. More is not faster once vLLM is saturated.
LLM_CONCURRENCY=4
# Max wait for a queue slot; beyond it the service answers with heuristics.
LLM_QUEUE_TIMEOUT_MS=30000
# Circuit breaker: after N consecutive failures, fail fast for the cooldown.
LLM_CIRCUIT_FAILURES=5
LLM_CIRCUIT_COOLDOWN_MS=30000

# --- Precomputation / mailbox sync (needs GRAPH_ENABLED=true) ---------------
# Pull new inbox messages via Graph delta query, index + triage + analyse them
# at background priority so GET /analyze/email/:id is instant.
PRECOMPUTE_ENABLED=false
SYNC_INTERVAL_MINUTES=10
SYNC_MAX_MESSAGES_PER_RUN=100
# GRAPH_AUTH_MODE=app only: mailboxes to sync (UPNs), or an AAD group to expand.
SYNC_USERS=
SYNC_GROUP_ID=
# Daily brief, built from precomputed analyses (one short model call per user).
DAILY_BRIEF_ENABLED=true
DAILY_BRIEF_HOUR=7
# Timezone of the brief schedule and of brief dates.
TZ=Europe/Zurich

# --- Database ---------------------------------------------------------------
# "memory" = in-memory repositories (demo, no Postgres). Otherwise a Postgres URL.
DATABASE_URL=memory
# DATABASE_URL=postgres://oao:oao@localhost:5432/oao
# Apply migrations at startup (advisory-locked, so replicas cannot race)
DB_AUTO_MIGRATE=true
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
# Seed demo data at startup in memory mode (default true) / données de démo en mode mémoire
DEMO_SEED=true

# --- Auth -------------------------------------------------------------------
# dev = identity from x-user-email / x-user-name headers (refused in production)
# aad = Azure AD v2 JWT validated with JWKS
AUTH_MODE=dev
AAD_TENANT_ID=
AAD_CLIENT_ID=
AAD_CLIENT_SECRET=
# Extra tenants accepted besides AAD_TENANT_ID (guest / multi-tenant). Empty = home tenant only.
AAD_ALLOWED_TENANTS=
# When set (e.g. access_as_user), tokens must carry it in `scp` or `roles`, else 401.
AAD_REQUIRE_SCOPE=
AAD_CLOCK_SKEW_SECONDS=60
# Comma-separated lists / listes séparées par des virgules
ADMIN_EMAILS=admin@northbridge.example
COMPLIANCE_EMAILS=compliance@northbridge.example
# Bearer token used by the admin dashboard. Must be >= 24 chars when NODE_ENV=production.
ADMIN_API_TOKEN=change-me

# --- Microsoft Graph (optional, needs AAD_* + Mail.Read… scopes) ------------
GRAPH_ENABLED=false
# obo = per-user delegated tokens (default, works with the add-in's SSO token)
# app = client credentials with the Mail.Read APPLICATION permission, restricted by an
#       Exchange application access policy — recommended for production (docs/AI_LOAD.md §5)
GRAPH_AUTH_MODE=obo

# --- Observability ----------------------------------------------------------
# Prometheus exposition at GET /metrics (outside the /api/v1 prefix).
METRICS_ENABLED=true
# When set, /metrics requires `Authorization: Bearer <token>`.
METRICS_TOKEN=
# Swagger UI + spec at /api/v1/docs (openapi.json is also emitted at build time).
API_DOCS_ENABLED=false
LOG_LEVEL=info
# json (production) | pretty (local development)
LOG_FORMAT=json

# --- Retention --------------------------------------------------------------
# audit_events is the legal trace — do not shorten without compliance sign-off.
AUDIT_RETENTION_DAYS=730
# email_index holds email text (and the daily briefs derived from it).
INDEX_RETENTION_DAYS=365
# How long an Idempotency-Key on POST /actions/approve is remembered.
IDEMPOTENCY_TTL_HOURS=24

# --- Transport --------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated allowed origins (add-in + admin) / origines CORS autorisées
CORS_ORIGINS=https://localhost:3000,http://localhost:3001
# Per-identity (not per-IP): behind a corporate NAT everyone shares one address.
RATE_LIMIT_PER_MINUTE=120
# true | false | a hop count ("1") | a comma-separated IP/CIDR allow-list
TRUST_PROXY=true
REQUEST_TIMEOUT_MS=30000
BODY_LIMIT_BYTES=2097152
# Drain window on SIGTERM; keep it below terminationGracePeriodSeconds (usually 30 s).
SHUTDOWN_TIMEOUT_MS=25000

# --- Misc -------------------------------------------------------------------
# Store raw email content in audit rows (default false: only hashes + structured details)
AUDIT_STORE_CONTENT=false
# Optional internal webhook called for "notify" actions and compliance escalations
NOTIFY_WEBHOOK_URL=
DEFAULT_LANGUAGE=fr
# Shown as FeatureFlags.organizationName in the add-in and the admin dashboard.
ORGANIZATION_NAME=Northbridge Capital
# Domains considered internal. Overrides DEFAULT_POLICY.internalDomains when no
# policy row exists yet; once an admin saves a policy, the policy wins.
INTERNAL_DOMAINS=northbridge.example
