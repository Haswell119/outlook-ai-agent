# ============================================================================
# Outlook AI Orchestrator — backend configuration / configuration du backend
# Copy to .env (never commit secrets) / Copier vers .env (jamais de secrets en git)
# ============================================================================

# --- AI model (OpenAI-compatible endpoint hosted internally) ---------------
# Provider: "openai-compatible" (vLLM, Ollama, LM Studio, TGI, Azure OpenAI…) or "mock" (demo/tests)
LLM_PROVIDER=mock
# Base URL of the OpenAI-compatible API (must end with /v1 for most servers)
LLM_BASE_URL=http://gpu-node.northbridge.local:8000/v1
# Optional API key, sent as "Authorization: Bearer …" only when set / clé optionnelle
LLM_API_KEY=
LLM_MODEL=qwen3-30b-a3b
LLM_TIMEOUT_MS=60000
LLM_MAX_TOKENS=2048
# How to force JSON output: auto | response_format | prompt
LLM_JSON_MODE=auto
# Embeddings (same endpoint, POST /embeddings). false → lexical search only / recherche lexicale seule
EMBEDDINGS_ENABLED=false
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024

# --- Database ---------------------------------------------------------------
# "memory" = in-memory repositories (demo, no Postgres). Otherwise a Postgres URL.
DATABASE_URL=memory
# DATABASE_URL=postgres://oao:oao@localhost:5432/oao
# Apply migrations at startup (default true outside production)
DB_AUTO_MIGRATE=true
# Seed demo data at startup in memory mode (default true) / données de démo en mode mémoire
DEMO_SEED=true

# --- Auth -------------------------------------------------------------------
# dev = identity from x-user-email / x-user-name headers (refused in production)
# aad = Azure AD v2 JWT validated with JWKS
AUTH_MODE=dev
AAD_TENANT_ID=
AAD_CLIENT_ID=
AAD_CLIENT_SECRET=
# Comma-separated lists / listes séparées par des virgules
ADMIN_EMAILS=admin@northbridge.example
COMPLIANCE_EMAILS=compliance@northbridge.example
# Bearer token used by the admin dashboard (dev) / jeton du dashboard admin
ADMIN_API_TOKEN=change-me

# --- Microsoft Graph (optional, needs AAD_* + Mail.Read… scopes) ------------
GRAPH_ENABLED=false

# --- Misc -------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated allowed origins (add-in + admin) / origines CORS autorisées
CORS_ORIGINS=https://localhost:3000,http://localhost:3001
RATE_LIMIT_PER_MINUTE=120
# Store raw email content in audit rows (default false: only hashes + structured details)
AUDIT_STORE_CONTENT=false
# Optional internal webhook called for "notify" actions and compliance escalations
NOTIFY_WEBHOOK_URL=
DEFAULT_LANGUAGE=fr
