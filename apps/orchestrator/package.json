{
  "name": "@oao/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI Orchestrator backend for the Outlook AI Orchestrator (Fastify 5 + PostgreSQL/pgvector + zod)",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/adapters/db/migrate.ts",
    "db:seed": "tsx src/adapters/db/seed.ts"
  },
  "dependencies": {
    "@azure/msal-node": "^2.16.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@oao/shared": "workspace:*",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.1.0",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.9",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
