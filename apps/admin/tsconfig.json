{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "ES2022"],
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "incremental": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "plugins": [{ "name": "next" }],
    /**
     * npm workspaces hoist @oao/addin's @types/react@18 to the repository-root
     * node_modules and nest this app's @types/react@19 under apps/admin. Next's
     * own .d.ts files sit in the hoisted tree, so an unpinned "react" resolves
     * to the React 18 typings — a second, incompatible React type tree. Pinning
     * the paths to ./node_modules keeps this app on @types/react@19 everywhere.
     *
     * `typeRoots` is pinned to this app's own @types folder for the same
     * reason: it anchors every `/// <reference types="react/experimental" />`
     * that next/dist/types.d.ts emits to apps/admin/node_modules/@types, so the
     * React 18 typings hoisted at the root are never pulled in. (The empty
     * `typings/react{,-dom}/experimental` shim packages this app used to carry
     * are no longer needed and have been deleted.)
     */
    "paths": {
      "@/*": ["./src/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    },
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
