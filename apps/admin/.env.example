# --- Admin dashboard (@oao/admin) -------------------------------------------
# Every variable is server-side only: no NEXT_PUBLIC_* exists, so no token or
# secret ever reaches the browser. Validated at startup by `src/env.ts`
# (zod) — an incomplete configuration fails fast instead of half-working.

# --- Orchestrator -----------------------------------------------------------

# Base URL of the AI Orchestrator (Fastify). No trailing slash.
ORCHESTRATOR_URL=http://localhost:8080

# Bearer sent on every server-side call when ADMIN_AUTH_MODE=token.
# Must match ADMIN_API_TOKEN of the orchestrator (AUTH_MODE=dev).
# Unused in ADMIN_AUTH_MODE=aad, where the operator's own access token is sent.
ADMIN_API_TOKEN=change-me

# Force the deterministic in-memory mock dataset (no orchestrator needed).
# Anything other than "true" uses the real orchestrator; in development the app
# still falls back to the mock automatically when the orchestrator is unreachable.
ADMIN_MOCK=true

# --- Authentication ---------------------------------------------------------

# aad   → Microsoft Entra ID sign-in (production).
# token → shared ADMIN_API_TOKEN + x-user-email headers (local dev, e2e, demos).
ADMIN_AUTH_MODE=token

# Identity used in `token` mode (mirrors the orchestrator's dev headers).
ADMIN_DEV_EMAIL=admin@northbridge.example
ADMIN_DEV_NAME=Dashboard Operator
ADMIN_DEV_ROLES=admin                 # admin | compliance | user (comma separated)

# --- Entra ID (required when ADMIN_AUTH_MODE=aad) ---------------------------

# openssl rand -base64 32
AUTH_SECRET=
# Public URL of the dashboard, e.g. https://oao-admin.northbridge.example
AUTH_URL=
# Dashboard app registration (NOT the orchestrator API app).
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# Application (client) id of the ORCHESTRATOR API app registration: the scope
# api://{id}/access_as_user is requested so the session carries an access token
# whose audience the orchestrator accepts.
ORCHESTRATOR_API_CLIENT_ID=
# Optional full override of that scope.
# ORCHESTRATOR_API_SCOPE=api://orchestrator.northbridge.example/access_as_user
# JWT session lifetime, seconds (300 – 86400).
ADMIN_SESSION_MAX_AGE=3600

# Role fallback when the tenant has not assigned the app roles yet. App roles
# from the token always win.
ADMIN_EMAILS=admin@northbridge.example
COMPLIANCE_EMAILS=compliance@northbridge.example

# --- Presentation -----------------------------------------------------------

# Default UI language (en | fr). Overridden per browser by the `oao_lang` cookie.
ADMIN_DEFAULT_LANGUAGE=en

# Fallback organisation label; FeatureFlags.organizationName wins when the
# orchestrator provides it.
ADMIN_TENANT_NAME=Northbridge Capital

# IANA timezone used to render every date and time.
ADMIN_TZ=Europe/Zurich
