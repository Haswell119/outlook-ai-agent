# --- Admin dashboard (@oao/admin) -------------------------------------------

# Base URL of the AI Orchestrator (Fastify). No trailing slash.
ORCHESTRATOR_URL=http://localhost:8080

# Bearer token sent as `Authorization: Bearer <token>` on every server-side call.
# Must match ADMIN_API_TOKEN of the orchestrator (AUTH_MODE=dev).
ADMIN_API_TOKEN=change-me

# Force the deterministic in-memory mock dataset (no orchestrator needed).
# Anything other than "true" uses the real orchestrator; in development the app
# still falls back to the mock automatically when the orchestrator is unreachable.
ADMIN_MOCK=true

# Default UI language (en | fr). Overridden per browser by the `oao_lang` cookie.
ADMIN_DEFAULT_LANGUAGE=en

# Tenant label shown in the top bar.
ADMIN_TENANT_NAME=ABC Capital
