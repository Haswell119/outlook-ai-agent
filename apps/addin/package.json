{
  "name": "@oao/addin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Outlook AI Orchestrator \u2014 Outlook add-in (task pane, compose Compliance Guardian, Smart Alerts on send)",
  "scripts": {
    "dev": "pnpm build:commands && vite --host localhost --port 3000",
    "build": "pnpm build:commands && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate-manifest": "node scripts/validate-manifest.mjs manifest/manifest.xml manifest/manifest.json",
    "validate-manifest:dev": "node scripts/validate-manifest.mjs manifest/manifest.dev.xml manifest/manifest.dev.json",
    "certs": "office-addin-dev-certs install --days 365",
    "icons": "node scripts/generate-icons.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "sideload": "echo \"See README.md: sideload manifest/manifest.dev.xml in Outlook (Get Add-ins > My add-ins > Add a custom add-in > Add from file)\"",
    "build:commands": "vite build -c vite.commands.config.ts",
    "analyze": "ANALYZE=1 pnpm build",
    "manifest:render": "node scripts/manifest-template.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.54.0",
    "@fluentui/react-icons": "^2.0.258",
    "@oao/shared": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^20.16.0",
    "@types/office-js": "^1.0.400",
    "@types/office-runtime": "^1.0.40",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.0",
    "office-addin-dev-certs": "^1.13.0",
    "office-addin-manifest": "^1.13.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "@playwright/test": "1.63.0",
    "rollup-plugin-visualizer": "^5.12.0"
  }
}
