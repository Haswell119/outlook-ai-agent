# Base URL of the AI Orchestrator (defaults: http://localhost:8080 in dev, https://localhost:8443 in prod builds).
# NOTE: this value is also baked into the CSP `connect-src` at build time — set it before `pnpm build`.
VITE_API_BASE_URL=http://localhost:8080
# Force the in-browser mock API (also enabled automatically in dev/preview when the backend health check fails)
VITE_API_MOCK=false
# dev -> x-user-email / x-user-name headers from Office.context.mailbox.userProfile ; aad -> Office SSO bearer token
VITE_AUTH_MODE=dev
# Admin dashboard (used by "View audit log" links)
VITE_ADMIN_URL=http://localhost:3001
# Compliance team mailbox ("Need help? Contact Compliance Team")
VITE_COMPLIANCE_EMAIL=compliance@northbridge.example

# --- Telemetry (optional). Never receives email content: see src/telemetry.ts ---
# Fetch-beacon endpoint. Unset -> no-op sink in production, console sink in dev.
# VITE_TELEMETRY_URL=https://telemetry.example.com/v1/events
# Application Insights connection string (the beacon posts to its /v2/track endpoint; no SDK is bundled).
# VITE_APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=https://westeurope-1.in.applicationinsights.azure.com/
# Build-time only: extra CSP connect-src origin when using Application Insights.
# VITE_APPINSIGHTS_INGESTION_ORIGIN=https://westeurope-1.in.applicationinsights.azure.com

# --- Build metadata / manifest rendering (read by vite.config.ts and scripts/manifest-template.mjs) ---
# ADDIN_VERSION=1.0.0.0
# ADDIN_SOURCEMAP=false
# ADDIN_HOST=https://addin.example.com
# API_HOST=https://api.example.com
# AAD_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ADDIN_ID=5d8b3f1c-0a7e-4d2b-9c6f-3e1a2b4c5d6e
# ORGANIZATION_NAME=Example Capital

# On-send compliance check failure mode: open (default, send allowed) | closed (send refused until the check works)
VITE_ONSEND_FAIL_MODE=open
