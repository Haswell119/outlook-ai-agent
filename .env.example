# ---------------------------------------------------------------------------
# Outlook AI Orchestrator — configuration (fichier .env unique, lu par
# l'orchestrator, et partiellement par docker-compose.yml).
#
#   cp .env.example .env
#
# C'est ce fichier que Longbow doit configurer pour brancher son modèle IA
# interne : voir la section "IA interne" ci-dessous (LLM_BASE_URL, LLM_MODEL,
# LLM_API_KEY, EMBEDDING_MODEL, EMBEDDING_DIMENSIONS). Voir docs/SETUP.md pour
# des exemples de commandes vLLM / Ollama / TGI.
# ---------------------------------------------------------------------------

# =============================================================================
# --- IA interne (endpoint OpenAI-compatible hébergé par Longbow) -----------
# =============================================================================
# "mock" = aucun modèle nécessaire, réponses déterministes (démo / CI / tests).
# "openai-compatible" = un vrai endpoint (vLLM, Ollama, TGI, LM Studio,
# Azure OpenAI privé...). C'est cette valeur que Longbow doit changer en prod.
LLM_PROVIDER=mock

# URL de base de l'API OpenAI-compatible exposée par le GPU Longbow (Qwen3).
# >>> À CONFIGURER PAR LONGBOW <<<  (ex: http://gpu-node.longbow.local:8000/v1)
LLM_BASE_URL=http://gpu-node.longbow.local:8000/v1

# Clé API si l'endpoint interne en exige une (souvent vide en interne).
# >>> À CONFIGURER PAR LONGBOW <<<
LLM_API_KEY=

# Nom du modèle tel que servi par vLLM/Ollama/TGI (--served-model-name).
# >>> À CONFIGURER PAR LONGBOW <<<
LLM_MODEL=qwen3-30b-a3b

# Timeout d'appel au modèle (ms) et nombre max de tokens générés en sortie.
LLM_TIMEOUT_MS=60000
LLM_MAX_TOKENS=2048

# Comment forcer une sortie JSON: auto (détecte les capacités du serveur),
# response_format (JSON mode natif de l'API), ou prompt (JSON demandé dans
# le prompt, pour les serveurs qui ne supportent pas response_format).
LLM_JSON_MODE=auto

# Active la recherche sémantique (pgvector) : résumés/chat citent des sources
# par similarité vectorielle en plus de la recherche lexicale.
EMBEDDINGS_ENABLED=true

# Modèle d'embeddings, servi sur le même endpoint OpenAI-compatible
# (/v1/embeddings) — ex: bge-m3 via `vllm serve --task embed` ou
# text-embeddings-inference.
# >>> À CONFIGURER PAR LONGBOW <<<
EMBEDDING_MODEL=bge-m3

# Dimension des vecteurs produits par EMBEDDING_MODEL (doit correspondre à la
# colonne vector(N) des migrations SQL — bge-m3 = 1024).
# >>> À CONFIGURER PAR LONGBOW <<<
EMBEDDING_DIMENSIONS=1024

# =============================================================================
# --- Base de données ---------------------------------------------------------
# =============================================================================
# "memory" = pas de Postgres nécessaire (démo/dev rapide, données non
# persistées). Sinon, chaîne de connexion PostgreSQL (pgvector requis).
DATABASE_URL=memory

# Identifiants utilisés par docker-compose.yml pour créer la base Postgres.
POSTGRES_USER=oao
POSTGRES_PASSWORD=oao
POSTGRES_DB=oao
POSTGRES_PORT=5432

# Applique automatiquement les migrations SQL (apps/orchestrator/migrations)
# au démarrage de l'orchestrator. En prod on préfère souvent lancer le Job de
# migration explicitement (voir infra/k8s) et laisser ceci à false.
DB_AUTO_MIGRATE=true

# =============================================================================
# --- Authentification ---------------------------------------------------------
# =============================================================================
# "dev" = accepte les en-têtes x-user-email / x-user-name (local uniquement,
# refusé si NODE_ENV=production). "aad" = valide un JWT Azure AD (JWKS).
AUTH_MODE=dev

# Azure AD App Registration (voir docs/SETUP.md pour la procédure complète:
# SPA + API exposée `access_as_user`, WebApplicationInfo du manifest).
AAD_TENANT_ID=
AAD_CLIENT_ID=
# Secret utilisé pour l'échange On-Behalf-Of vers Microsoft Graph — jamais en
# clair en dehors de ce fichier local / d'un secret manager.
AAD_CLIENT_SECRET=

# Emails traités comme admin/compliance en mode AUTH_MODE=dev (listes
# séparées par des virgules).
ADMIN_EMAILS=admin@longbow.ch
COMPLIANCE_EMAILS=compliance@longbow.ch

# Jeton bearer utilisé par le dashboard admin en dev (AUTH_MODE=dev). En prod
# utiliser AAD pour le dashboard aussi.
ADMIN_API_TOKEN=change-me

# =============================================================================
# --- Microsoft Graph (optionnel, phase 2+) ----------------------------------
# =============================================================================
# false = uniquement le chemin Office.js (lecture de l'item ouvert, aucune
# permission Graph nécessaire). true = échange OBO du token Office SSO vers
# Graph pour indexer la boîte, créer des tâches/rappels, déplacer des messages.
GRAPH_ENABLED=false

# =============================================================================
# --- Divers / orchestrator ---------------------------------------------------
# =============================================================================
PORT=8080
# Origines autorisées à appeler l'API (CORS) — l'origine de l'add-in en prod,
# ou https://localhost:3000 en dev.
CORS_ORIGINS=https://localhost:3000

# Si true, le corps brut des emails est conservé dans l'audit (par défaut
# seuls des hashes SHA-256 prompt/réponse sont stockés — minimisation des
# données, voir docs/SECURITY.md).
AUDIT_STORE_CONTENT=false

# Webhook interne optionnel appelé par l'action "notify".
NOTIFY_WEBHOOK_URL=

# Langue par défaut (fr | en) quand ni Accept-Language ni `language` ne sont
# fournis.
DEFAULT_LANGUAGE=fr

# Niveau de log Fastify/pino: fatal | error | warn | info | debug | trace.
LOG_LEVEL=info

# Nombre de requêtes autorisées par minute et par utilisateur/IP
# (@fastify/rate-limit).
RATE_LIMIT_PER_MINUTE=120

# =============================================================================
# --- Admin dashboard (@oao/admin, Next.js) ----------------------------------
# =============================================================================
# URL de l'orchestrator vue depuis le serveur Next.js (SSR / route handlers).
ORCHESTRATOR_URL=http://localhost:8080
# ADMIN_API_TOKEN est réutilisé ci-dessus pour l'appel orchestrator → admin.
# true = le dashboard sert des données factices sans appeler l'orchestrator
# (démo/design sans backend).
ADMIN_MOCK=false
ADMIN_PORT=3001

# =============================================================================
# --- Add-in (@oao/addin, Vite — variables injectées au build) --------------
# =============================================================================
# Base URL de l'API orchestrator consommée par l'add-in.
VITE_API_BASE_URL=https://api.oao.longbow.local/api/v1
# URL du dashboard admin (lien "View audit log").
VITE_ADMIN_URL=https://admin.oao.longbow.local
# dev = même logique que AUTH_MODE côté add-in (headers), aad = SSO Office/AAD.
VITE_AUTH_MODE=dev
# true = l'add-in fonctionne contre des réponses mockées, sans backend
# (démo autonome / design).
VITE_API_MOCK=false
