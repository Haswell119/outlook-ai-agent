# ---------------------------------------------------------------------------
# Outlook AI Orchestrator — configuration (fichier .env unique, lu par
# l'orchestrator et partiellement par docker-compose*.yml).
#
#   pnpm setup:dev        # copie ce fichier en .env et prépare l'environnement
#   # ou :  cp .env.example .env
#
# Tel quel, ce fichier démarre en MODE DÉMO : aucun modèle IA, aucune base de
# données requise (LLM_PROVIDER=mock, DATABASE_URL=memory, AUTH_MODE=dev).
#
# EN PRODUCTION, ce fichier n'est PAS le mécanisme de configuration : le
# déploiement passe par le chart Helm (infra/helm) et Flux (infra/gitops), où
# les valeurs non secrètes vivent dans values-nkp.yaml et les secrets dans un
# Secret chiffré SOPS ou fourni par External Secrets. Voir docs/NKP.md.
# ---------------------------------------------------------------------------

# =============================================================================
# --- Rôle du processus -------------------------------------------------------
# =============================================================================
# api    = sert l'API HTTP /api/v1/* (+ /metrics)
# worker = jobs de fond uniquement : mailbox sync, précalcul, daily brief,
#          rétention. Élection de leader par advisory lock PostgreSQL.
# all    = les deux dans un seul processus (dev, démo, Docker mono-machine).
ROLE=all

# =============================================================================
# --- IA interne (endpoint OpenAI-compatible hébergé par Northbridge) ---------
# =============================================================================
# "mock" = aucun modèle nécessaire, réponses déterministes (démo / CI / tests).
# "openai-compatible" = un vrai endpoint (vLLM, Ollama, TGI, LM Studio,
# Azure OpenAI privé...). C'est cette valeur que Northbridge met en prod.
LLM_PROVIDER=mock

# URL de base de l'API OpenAI-compatible exposée par le GPU Northbridge.
# >>> À CONFIGURER <<<  (ex: http://gpu-node.northbridge.example:8000/v1)
LLM_BASE_URL=http://gpu-node.northbridge.example:8000/v1

# Clé API si l'endpoint interne en exige une (souvent vide en interne).
# En Kubernetes, préférer LLM_API_KEY_FILE (voir "Secrets montés" plus bas).
LLM_API_KEY=

# Nom du modèle tel que servi par vLLM/Ollama/TGI (--served-model-name).
LLM_MODEL=qwen3-30b-a3b

# Modèle plus petit/rapide pour le triage, la classification, l'anti-phishing
# et l'extraction (optionnel — le modèle principal est utilisé si vide).
LLM_FAST_MODEL=

# Timeout d'appel au modèle (ms) et nombre max de tokens générés en sortie.
LLM_TIMEOUT_MS=60000
LLM_MAX_TOKENS=2048

# Comment forcer une sortie JSON : auto (détecte les capacités du serveur),
# response_format (JSON mode natif de l'API), ou prompt (JSON demandé dans le
# prompt, pour les serveurs sans response_format).
LLM_JSON_MODE=auto

# Appels simultanés au modèle, timeout d'attente en file, et circuit breaker
# (nombre d'échecs consécutifs avant ouverture, durée de refroidissement).
LLM_CONCURRENCY=4
LLM_QUEUE_TIMEOUT_MS=30000
LLM_CIRCUIT_FAILURES=5
LLM_CIRCUIT_COOLDOWN_MS=30000

# Taille max du contexte texte envoyé au modèle (caractères, pas tokens).
LLM_INPUT_MAX_CHARS=12000

# Active la recherche sémantique (pgvector) : résumés/chat citent des sources
# par similarité vectorielle en plus de la recherche lexicale.
EMBEDDINGS_ENABLED=true

# Modèle d'embeddings, servi sur le même endpoint OpenAI-compatible
# (/v1/embeddings) — ex: bge-m3 via `vllm serve --task embed` ou
# text-embeddings-inference.
EMBEDDING_MODEL=bge-m3

# Dimension des vecteurs produits par EMBEDDING_MODEL. DOIT correspondre à la
# colonne vector(N) des migrations SQL (bge-m3 = 1024). `pnpm check:llm`
# vérifie la cohérence avec l'endpoint réel.
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=64

# =============================================================================
# --- Base de données ---------------------------------------------------------
# =============================================================================
# "memory" = pas de PostgreSQL nécessaire (démo/dev rapide, données non
# persistées). Sinon, chaîne de connexion PostgreSQL (extension pgvector
# requise). En Kubernetes : DATABASE_URL_FILE.
DATABASE_URL=memory

# Identifiants utilisés par docker-compose*.yml pour créer la base.
POSTGRES_USER=oao
POSTGRES_PASSWORD=oao
POSTGRES_DB=oao
POSTGRES_PORT=5432

# Applique automatiquement les migrations SQL (apps/orchestrator/migrations)
# au démarrage. En production, laisser false : le chart Helm applique les
# migrations via un Job (hook pre-install/pre-upgrade) avant le rollout.
DB_AUTO_MIGRATE=true

# Pool de connexions et garde-fou contre les requêtes longues.
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000

# =============================================================================
# --- Authentification --------------------------------------------------------
# =============================================================================
# "dev" = accepte les en-têtes x-user-email / x-user-name (local uniquement,
# refusé si NODE_ENV=production). "aad" = valide un JWT Entra ID (JWKS).
AUTH_MODE=dev

# Entra ID (Azure AD) App Registration — voir docs/SETUP.md §Entra ID
# (API exposant `access_as_user`, app roles, WebApplicationInfo du manifest).
AAD_TENANT_ID=
AAD_CLIENT_ID=
# Secret utilisé pour l'échange On-Behalf-Of vers Microsoft Graph.
# En Kubernetes : AAD_CLIENT_SECRET_FILE.
AAD_CLIENT_SECRET=
# Tenants supplémentaires acceptés (rare, normalement vide = single tenant).
AAD_ALLOWED_TENANTS=
# Scope exigé dans le jeton entrant.
AAD_REQUIRE_SCOPE=access_as_user
AAD_CLOCK_SKEW_SECONDS=60

# Emails traités comme admin/compliance quand les app roles ne sont pas
# encore assignés (listes séparées par des virgules).
ADMIN_EMAILS=admin@northbridge.example
COMPLIANCE_EMAILS=compliance@northbridge.example

# Jeton bearer partagé entre le dashboard admin et l'orchestrator.
# En Kubernetes : ADMIN_API_TOKEN_FILE.
ADMIN_API_TOKEN=change-me

# =============================================================================
# --- Microsoft Graph (optionnel) ---------------------------------------------
# =============================================================================
# false = uniquement le chemin Office.js (lecture de l'item ouvert, aucune
# permission Graph nécessaire). true = accès Graph pour indexer la boîte,
# créer des tâches/rappels, déplacer des messages.
GRAPH_ENABLED=false

# obo = jeton délégué échangé On-Behalf-Of (par utilisateur, à la demande).
# app = permissions applicatives, nécessaires au worker de précalcul, et à
#       restreindre par une Exchange application access policy limitée à un
#       groupe de sécurité mail-enabled (docs/SETUP.md).
GRAPH_AUTH_MODE=obo

# =============================================================================
# --- Worker : synchronisation, précalcul, daily brief ------------------------
# =============================================================================
# Interrupteur général des jobs de fond (indépendant de ROLE).
WORKERS_ENABLED=true

# Boîtes synchronisées en GRAPH_AUTH_MODE=app : soit un groupe (recommandé,
# même groupe que l'application access policy), soit une liste d'UPN.
SYNC_GROUP_ID=
SYNC_USERS=
SYNC_INTERVAL_MINUTES=10
SYNC_MAX_MESSAGES_PER_RUN=100

# Précalcul des analyses pour les boîtes synchronisées (ouverture instantanée
# du volet) et brief quotidien.
PRECOMPUTE_ENABLED=false
DAILY_BRIEF_ENABLED=true
DAILY_BRIEF_HOUR=7

# =============================================================================
# --- Caches, rétention, prompts ---------------------------------------------
# =============================================================================
TRIAGE_ENABLED=true
ANALYSIS_CACHE_ENABLED=true
ANALYSIS_CACHE_TTL_HOURS=168
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_TTL_DAYS=365
THREAD_MAX_MESSAGES=12

# Durées de conservation appliquées par le worker (jours). L'audit est la
# trace légale/compliance : toute réduction doit être validée (docs/SECURITY.md).
AUDIT_RETENTION_DAYS=730
INDEX_RETENTION_DAYS=365
IDEMPOTENCY_TTL_HOURS=24

# Si true, le corps brut des emails est conservé dans l'audit. Par défaut
# seuls des hashes SHA-256 prompt/réponse sont stockés (minimisation des
# données) — n'activer qu'après validation compliance.
AUDIT_STORE_CONTENT=false

# =============================================================================
# --- Serveur HTTP, observabilité --------------------------------------------
# =============================================================================
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
ORGANIZATION_NAME=Northbridge Capital

# Origines autorisées à appeler l'API (CORS) — l'origine de l'add-in.
CORS_ORIGINS=https://localhost:3000

# Langue par défaut (fr | en) quand ni Accept-Language ni `language` ne sont
# fournis.
DEFAULT_LANGUAGE=fr

# Domaines considérés comme internes par le moteur de conformité.
INTERNAL_DOMAINS=northbridge.example

# Logs : niveau pino et format (json en prod, pretty en dev).
LOG_LEVEL=info
LOG_FORMAT=pretty

# Requêtes par minute et par utilisateur/IP (@fastify/rate-limit), taille max
# du corps de requête, timeouts.
RATE_LIMIT_PER_MINUTE=120
BODY_LIMIT_BYTES=2097152
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=25000

# /metrics au format Prometheus. En production, METRICS_TOKEN est obligatoire
# (bearer token) et /metrics n'est joignable que depuis le namespace de
# monitoring (NetworkPolicy). En Kubernetes : METRICS_TOKEN_FILE.
METRICS_ENABLED=true
METRICS_TOKEN=

# Swagger UI sur /docs — à laisser false en production.
API_DOCS_ENABLED=false

# Webhook interne optionnel appelé par l'action "notify".
NOTIFY_WEBHOOK_URL=

# Insère des données de démonstration au seed. JAMAIS true en production.
DEMO_SEED=true

# =============================================================================
# --- Secrets montés en fichiers (Kubernetes / NKP) --------------------------
# =============================================================================
# Pour chaque variable sensible FOO, l'orchestrator accepte aussi
# FOO_FILE=/chemin/vers/fichier et lit le contenu au démarrage. C'est le mode
# par défaut du chart Helm (secrets.mountAsFiles=true) : aucun secret dans
# l'environnement du pod, ni dans `kubectl describe pod`.
#
#   LLM_API_KEY_FILE=/run/secrets/oao/LLM_API_KEY
#   AAD_CLIENT_SECRET_FILE=/run/secrets/oao/AAD_CLIENT_SECRET
#   ADMIN_API_TOKEN_FILE=/run/secrets/oao/ADMIN_API_TOKEN
#   METRICS_TOKEN_FILE=/run/secrets/oao/METRICS_TOKEN
#   DATABASE_URL_FILE=/run/secrets/oao/DATABASE_URL

# =============================================================================
# --- Dashboard admin (@oao/admin, Next.js) ----------------------------------
# =============================================================================
# URL de l'orchestrator vue depuis le serveur Next.js (SSR / route handlers).
ORCHESTRATOR_URL=http://localhost:8080
ADMIN_PORT=3001

# aad = connexion Entra ID (production), token = ADMIN_API_TOKEN partagé
# uniquement (dev/démo).
ADMIN_AUTH_MODE=token

# Auth.js / Entra ID pour le dashboard (ADMIN_AUTH_MODE=aad).
AUTH_URL=https://admin.oao.northbridge.example
AUTH_TRUST_HOST=true
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=

# true = le dashboard sert des données factices sans appeler l'orchestrator
# (démo/design sans backend).
ADMIN_MOCK=false

# =============================================================================
# --- Add-in (@oao/addin) ----------------------------------------------------
# =============================================================================
# Hôtes publics, utilisés par `pnpm manifest:render` (manifests Office) et par
# les build args des images Docker. Sans schéma pour docker-compose, avec
# https:// pour manifest:render (voir docs/SETUP.md).
ADDIN_HOST=addin.oao.northbridge.example
API_HOST=api.oao.northbridge.example
ADMIN_HOST=admin.oao.northbridge.example

# Variables injectées AU BUILD dans le bundle Vite (jamais au runtime).
VITE_API_BASE_URL=https://api.oao.northbridge.example/api/v1
VITE_ADMIN_URL=https://admin.oao.northbridge.example
# dev = mêmes en-têtes que AUTH_MODE=dev côté add-in, aad = SSO Office/Entra.
VITE_AUTH_MODE=dev
# true = l'add-in fonctionne contre des réponses mockées, sans backend.
VITE_API_MOCK=false

# =============================================================================
# --- Déploiement Docker depuis les images publiées (docker-compose.prod.yml) -
# =============================================================================
# Registre et version des images GHCR, répertoire du certificat TLS de
# l'add-in, interfaces d'écoute.
OAO_REGISTRY=ghcr.io/northbridge-capital
OAO_VERSION=0.1.0
ADDIN_CERT_DIR=./certs/addin
ORCHESTRATOR_BIND=127.0.0.1
ADMIN_BIND=127.0.0.1
ADDIN_BIND=0.0.0.0
BACKUP_RETENTION_DAYS=14
