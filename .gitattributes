# Normalise line endings so Windows, macOS and Linux see the same bytes.
* text=auto eol=lf

# Scripts and configs that MUST stay LF (shebangs, containers, k8s).
*.sh        text eol=lf
*.mjs       text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.tpl       text eol=lf
*.sql       text eol=lf
*.md        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.xml       text eol=lf
Dockerfile  text eol=lf
*.Dockerfile text eol=lf
.env.example text eol=lf
.gitattributes text eol=lf

# Windows-only files keep CRLF.
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# Binary assets: never touched.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.pdf       binary
*.zip       binary

# Generated files: collapsed in diffs and excluded from language stats.
package-lock.json         linguist-generated=true -diff
infra/k8s/rendered/**     linguist-generated=true
apps/*/docs/screenshots/* linguist-generated=true
