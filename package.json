{
  "name": "outlook-ai-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Outlook AI Orchestrator - secure, human-in-the-loop AI assistant for Outlook (add-in + orchestrator backend + admin dashboard)",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm --filter @oao/shared build && pnpm -r --filter \"./apps/**\" build",
    "dev": "pnpm --filter @oao/shared build && pnpm -r --parallel --filter \"./apps/**\" dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @oao/orchestrator db:migrate",
    "db:seed": "pnpm --filter @oao/orchestrator db:seed"
  }
}
